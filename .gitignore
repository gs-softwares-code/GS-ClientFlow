# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log

# env files (explicitly exclude all .env files except .env.example)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.production.example

# database & runtime state
db/*.db
db/*.db-journal
db/*.db-wal
prisma/db/*.db
prisma/db/*.db-journal
prisma/db/*.db-wal

# ephemeral process pids and tool artifacts
.zscripts/*.pid
.zscripts/*.log
tool-results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
prompt

# Skills directory
/skills/

# graft local graph cache (regenerable)
/graft/
