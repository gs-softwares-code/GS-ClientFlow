# ==============================================================================
# GS ClientFlow — Environment Configuration Template
# Copy this file to .env or configure in your deployment provider (Neon, Cloudflare, Vercel)
# ==============================================================================

# Database Connection (Neon PostgreSQL with connection pooling in production)
# Format: postgres://<user>:<password>@<ep-pooler-id>.region.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgres://postgres:sample_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# For local development with SQLite fallback:
# DATABASE_URL="file:./db/custom.db"

# Server Environment & Network Binding
NODE_ENV="development"
PORT="3000"
HOSTNAME="127.0.0.1"

# Cryptographic & PII Encryption Master Key (AES-256-GCM 32-byte hex string)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Outbox Worker & Webhook Event HMAC Signing Secret (64-byte hex string)
OUTBOX_HMAC_SECRET="abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

# Arcjet Security / WAF / Bot Rate Limiting Key
ARCJET_KEY="ajkey_01samplekeyforarcjetwafshieldprotection0000"

# Cloudflare Turnstile Bot Defense (Server secret & client site key)
TURNSTILE_SECRET="0x4AAAAAAASampleTurnstileSecretKey0000000000"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAASampleTurnstileSiteKey0000000"
