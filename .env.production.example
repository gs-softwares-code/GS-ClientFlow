# ==============================================================================
# GS ClientFlow — Production Environment Configuration (.env.production)
# ==============================================================================

# 1. Database Connection (Neon PostgreSQL with connection pooling & strict RLS)
# Format: postgres://<user>:<password>@<ep-pooler-id>.region.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgres://postgres:your_secure_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Server Environment & Network Binding
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# 3. Domain & Public Hostname (e.g. app.yourdomain.com or yourdomain.com, *.yourdomain.com)
APP_DOMAIN="app.yourdomain.com"

# 4. Cryptographic Master Key (AES-256-GCM 32-byte / 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 5. Outbox Worker & Webhook Event HMAC Signing Secret (64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OUTBOX_HMAC_SECRET="abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

# 6. Arcjet Security / WAF / Bot Rate Limiting Key
ARCJET_KEY="ajkey_live_samplearcjetkey0000000000000000"

# 7. Cloudflare Turnstile Bot Defense (Server secret & client site key)
TURNSTILE_SECRET="0x4AAAAAAASampleTurnstileSecretKey0000000000"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAASampleTurnstileSiteKey0000000"
